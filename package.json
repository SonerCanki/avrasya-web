{
  "name": "avrasya-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node tools/onceden-uret.mjs",
    "preview": "vite preview",
    "test:birim": "node --test tools/test/birim/",
    "test:tarayici": "npm --prefix tools/test test",
    "test": "npm run test:birim && npm run build && npm run test:tarayici",
    "lighthouse": "npm run build && npm --prefix tools/test run lighthouse"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "lenis": "^1.3.27",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
